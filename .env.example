TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_BASE_URL=http://127.0.0.1:8088
DASHBOARD_TOKEN=replace-with-a-long-random-secret
DB_PATH=./data/jobs.sqlite3
DISCOVERY_INTERVAL_MINUTES=60
# Optional: session lifetime, and COOKIE_SECURE=false only if your browser rejects Secure cookies on http://localhost
SESSION_HOURS=12
COOKIE_SECURE=true

# Automatic tailored CV generation (app/cv_pipeline.py). Keep the key only here, never in code.
# Get a key at https://aistudio.google.com/apikey. Check it with: .venv/bin/python -m app.cv_pipeline --check
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
# Generate automatically for new jobs with score >= CV_MIN_SCORE (false = only on request)
CV_AUTO_GENERATE=true
CV_MIN_SCORE=70
# Optional safety control: max AUTOMATIC CVs per local day (-1 = no fixed limit; approved/manual CVs never count)
CV_DAILY_LIMIT=-1
CV_TIMEZONE=Europe/Amsterdam
CV_WORKER_CONCURRENCY=1              # parallel CV generations (keep 1 on an e2-micro)
LLM_MAX_REQUESTS_PER_DAY=250         # hard daily stop for Gemini calls (cost/quota protection); -1 = unlimited
LLM_RATE_LIMIT_COOLDOWN_SECONDS=120  # pause all CV generation after a Gemini 429

# Approval workflows: >= CV_MIN_SCORE automatic CV + "Approve & Apply"; APPROVAL_MIN_SCORE..CV_MIN_SCORE-1
# "Approve CV & Apply"; below: dashboard only
APPROVAL_MIN_SCORE=40
TELEGRAM_ACTIONS_PER_BATCH=8         # individual actionable Telegram messages per batch (rest: dashboard)
TELEGRAM_ALLOWED_USER_IDS=           # optional: only these Telegram user ids may press buttons (chat id is always checked)

# Application submission: off (default) = readiness check + manual apply link; dry_run = build but never send;
# live = real submission, only for live-capable adapters listed in APPLY_LIVE_ADAPTERS (none exist yet)
APPLY_MODE=off
APPLY_LIVE_ADAPTERS=
APPLY_MAX_ATTEMPTS=3
# Bounded retries for temporary API errors (429/5xx/timeouts): base * 4^(attempt-1), capped
CV_MAX_ATTEMPTS=5
CV_RETRY_BASE_SECONDS=60
CV_RETRY_MAX_SECONDS=21600
# Minimum seconds between LLM requests (free-tier friendly); request timeout
LLM_MIN_INTERVAL_SECONDS=15
LLM_TIMEOUT_SECONDS=120

# Optional job-board APIs for discovery (sources stay 'not_configured' until set)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
